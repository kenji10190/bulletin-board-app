<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>投稿編集</title>
</head>
<body class="bg-gray-100 flex justify-center items-center min-h-screen">
    <div class="bg-white w-full max-w-2xl p-5 rounded shadow">
      <h2 class="text-2xl pb-5">投稿編集</h2>
      <form method="POST" action="/posts/<%=post.id%>/edit">
        <div class="pb-5">
          <label for="title">タイトル</label>
          <input type="text" name="title" value="<%=post.title %>" class="border w-full" required>
        </div> 
        <div>
          <label for="content">内容</label>
          <textarea name="content" class="border w-full" required><%= post.content %></textarea>
        </div>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="flex justify-end">
          <button type="submit" class="mt-4 bg-blue-500 text-white px-4 py-2 rounded">更新</button>
        </div>
      </form>
    </div>
</body>
</html>
