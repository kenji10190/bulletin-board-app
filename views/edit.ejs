<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>編集</title>
</head>
<body>
    <form method="POST" action="/posts/<%=post.id%>/edit" class="max-w-md mx-auto">
      <div>
        <label for="title">タイトル</label>
        <input type="text" name="title" value="<%=post.title %>" class="border w-full" required>
      </div> 
      <div class="mt-2">
        <label for="content">内容</label>
        <textarea name="content" class="border w-full" required><%= post.content %></textarea>
      </div>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="mt-4 bg-blue-500 text-white px-4 py-2 rounded">更新</button>
    </form>
</body>
</html>
